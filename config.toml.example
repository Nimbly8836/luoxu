[telegram]
api_id = 10000
api_hash = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
account = "+1234567890"
# device_model = "PC 64bit"
# system_version = "6.8.1"
# app_version = "telethon 1.34.0"
session_db = "mybot"
index_groups = [
  "@group1",
  "@group2",
  "1000000000",
]
# One-time repair of legacy fake topics, only for groups you confirm did not
# use Topics. Also requires full Telegram metadata confirming a non-forum peer.
# Back up the DB first. Topic-only grants are removed, not widened to the group.
# repair_non_forum_groups = [1000000000]
# Explicit one-to-one chats only; private chats are never public by default.
# index_private_chats = ["@alice", "123456789"]
# ipv6 = false
# socks5 proxy
# proxy = ["127.0.0.1", "1080"]
# mark_as_read = true
# ocr_ignore_groups = [
#   "@group1",
#   "1000000000",
# ]

[database]
url = "postgresql:///luoxu"
# use an OCR service for images; service is provided by the backend of https://github.com/lilydjwg/paddleocr-web
# ocr_url = "http://localhost:12345/api"
# use a UNIX domain socket to connect
# ocr_socket = "/path/to/socket/file"

[web]
listen_host = "localhost"
listen_port = 9008
prefix = "/luoxu"
cache_dir = "cache"
default_avatar = "nobody.jpg"
ghost_avatar = "ghost.jpg"
origins = [
  "http://localhost",
]
public_groups = [
  1000000000,
]

[web.auth]
# Generate with: python -c "from luoxu.auth import AuthService; print(AuthService.random_secret())"
jwt_secret = "replace-with-a-random-secret"
access_token_ttl = 900
refresh_token_ttl = 2592000

[web.auth.bootstrap_admin]
username = "admin"
# Generate with: python -c "from luoxu.auth import AuthService; print(AuthService({'jwt_secret':'x'}).hash_password('change-me'))"
password_hash = "$argon2id$v=19$..."

[web.context]
before = 5
after = 5
max_window = 20
reply_depth = 5

[web.message_history]
# Privacy-sensitive feature; no snapshots are captured while false.
enabled = false
# vim: se ft=toml:
